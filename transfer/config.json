{
  "socks5_listen": "0.0.0.0:30000",
  "http_listen": "0.0.0.0:41006",
  "backends": [
    "socks5://127.0.0.1:10801",
    "http://127.0.0.1:80801",
    "socks5://127.0.0.1:10802"
  ],
  "session_timeout": "12h",
  "read_limit_bytes_per_sec": 62500000,
  "write_limit_bytes_per_sec": 62500000,
  "burst_bytes": 0,
  "log": {
    "ServiceName": "transfer",
    "Mode": "file",
    "Path": "logs",
    "Level": "info",
    "Rotation": "size",
    "MaxSize": 20400,
    "MaxBackups": 2,
    "Compress": true,
    "KeepDays": 0
  }
}